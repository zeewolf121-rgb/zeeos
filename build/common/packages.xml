<!-- Shared package set: minimal base plus the live Plasma desktop (Wayland only). Arch packages live in build/arch/<arch>/. -->
<image>
<packages type="image">
  <package name="basesystem"/>
  <package name="bash"/>
  <package name="coreutils"/>
  <package name="dnf5"/>
  <package name="dracut-kiwi-live"/>
  <package name="dracut-live"/>
  <package name="dracut-config-generic"/>
  <package name="fedora-release-identity-basic"/>
  <package name="glibc-langpack-en"/>
  <package name="iproute"/>
  <package name="kernel"/>
  <package name="kernel-modules"/>
  <package name="kernel-modules-extra"/>
  <package name="NetworkManager"/>
  <package name="passwd"/>
  <package name="selinux-policy-targeted"/>
  <package name="squashfs-tools"/>
  <package name="sudo"/>
  <package name="systemd"/>
  <package name="util-linux"/>
  <package name="vim-minimal"/>
  <package name="plasma-desktop"/>
  <package name="kwin"/>
  <package name="sddm"/>
  <package name="sddm-wayland-plasma"/>
  <!-- From boot-test diagnostics (run 39016137155): pam_systemd.so missing (no logind session /
       XDG_RUNTIME_DIR), session exit 127 (startplasma-wayland / dbus-run-session), no DRM, no theme. -->
  <package name="systemd-pam"/>
  <package name="plasma-workspace"/>
  <package name="dbus-tools"/>
  <package name="mesa-dri-drivers"/>
  <package name="sddm-breeze"/>
  <!-- P2-1: no Fedora branding. generic-logos replaces fedora-logos (and its 01-breeze-fedora SDDM theme);
       adw-gtk3 themes GTK3 and the xdg portals carry libadwaita colour-scheme/accent. -->
  <package name="generic-logos"/>
  <package name="adw-gtk3-theme"/>
  <package name="xdg-desktop-portal"/>
  <package name="xdg-desktop-portal-kde"/>
  <package name="xdg-desktop-portal-gtk"/>
  <!-- Exclude Fedora branding at install time (dnf exclude), not <packages type="uninstall">:
       uninstall also removes every package depending on them, which took plasma-workspace and
       the plasma.desktop session with it (#98, run 39057784343). generic-logos provides
       system-logos instead; a hard dependency on these names now fails the build loudly. -->
  <!-- plasma-lookandfeel-fedora stays: plasma-workspace requires it at the exact version (run
       39059081199). It's only a dependency; P2-2 makes ZeeOS the default via /etc/xdg. -->
  <ignore name="fedora-logos"/>
  <ignore name="fedora-logos-classic"/>
</packages>
</image>
