# SPDX-License-Identifier: GPL-3.0-or-later
# Start the unattended install (P4-9, #181) only for a virtio disk with serial ZEEOS-AUTOINSTALL,
# and only in the live session (the unit checks rd.live.image). No such disk: nothing runs.
# RUN, not SYSTEMD_WANTS: the disk is already present in the initrd (which has no such rule), so
# after switch-root systemd sees its device unit as already plugged and never applies the wants.
# The coldplug "add" event after switch-root does run this (seen live: the unit stayed dead).
ACTION=="add", SUBSYSTEM=="block", ENV{DEVTYPE}=="disk", KERNEL=="vd*", ATTRS{serial}=="ZEEOS-AUTOINSTALL", RUN+="/usr/bin/systemctl --no-block start zeeos-autoinstall.service"
