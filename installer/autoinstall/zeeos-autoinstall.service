# installer-disk. Unattended CI install (P4-9, #181). Not enabled by any target: only
# 90-zeeos-autoinstall.rules starts it, when the ZEEOS-AUTOINSTALL preset disk appears.
[Unit]
Description=ZeeOS unattended install (CI preset disk present)
ConditionKernelCommandLine=rd.live.image
ConditionPathExists=/dev/disk/by-id/virtio-ZEEOS-AUTOINSTALL
After=systemd-udevd.service local-fs.target
# No Conflicts=zeeos-desktop-ready.service: that unit starts later in the boot, and a conflicting
# start stops this one, killing the install mid-way. The marker unit is harmless alongside it.

[Service]
Type=oneshot
ExecStart=/usr/libexec/zeeos-autoinstall
StandardOutput=journal+console
TimeoutStartSec=infinity
