# ZeeOS KWin defaults (P3-4): enable the snap-layout picker and the tiling toggle.
[Plugins]
zeeos-snap-layoutsEnabled=true
zeeos-tilingEnabled=true
# Design-language effects (P3-5): blur behind translucent panels, menus and KRunner.
blurEnabled=true
slidingpopupsEnabled=true
squashEnabled=true
fadeEnabled=true

[Effect-blur]
BlurStrength=8
NoiseStrength=4
