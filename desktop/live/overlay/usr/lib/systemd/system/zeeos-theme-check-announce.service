# Pulled in by zeeos-desktop-ready.service (Wants=), so no separate enable step.
[Unit]
Description=ZeeOS theme check announcement (serial console)
Before=zeeos-desktop-ready.service
ConditionKernelCommandLine=rd.live.image

[Service]
Type=oneshot
ExecStart=/usr/libexec/zeeos-theme-check announce
