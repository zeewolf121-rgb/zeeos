# Same defaults as org.zeeos.base (scheme, wallpaper), plus the Windows window button order (right: min, max, close).
[kdeglobals][General]
ColorScheme=ZeeOSLight

[kdeglobals][KDE]
widgetStyle=Breeze

[kwinrc][org.kde.kdecoration2]
library=org.kde.kwin.aurorae
theme=__aurorae__svg__ZeeOS-Plain-Light
ButtonsOnLeft=
ButtonsOnRight=IAX

[Wallpaper]
Image=/usr/share/wallpapers/ZeeOS
