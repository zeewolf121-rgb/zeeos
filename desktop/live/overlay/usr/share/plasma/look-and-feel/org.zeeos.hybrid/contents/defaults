# Same defaults as org.zeeos.base (scheme, wallpaper), plus the Hybrid window button order (left: close, min, max).
[kdeglobals][General]
ColorScheme=ZeeOSLight

[kdeglobals][KDE]
widgetStyle=Breeze

[kwinrc][org.kde.kdecoration2]
library=org.kde.kwin.aurorae
theme=__aurorae__svg__ZeeOS-Light
ButtonsOnLeft=XIA
ButtonsOnRight=

[Wallpaper]
Image=/usr/share/wallpapers/ZeeOS
