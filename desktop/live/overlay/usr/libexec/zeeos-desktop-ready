#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Print ZEEOS_DESKTOP_READY to the serial console once plasmashell runs on Wayland.
# Runs as a root system unit: a user unit cannot open the serial tty.
# If the desktop isn't up after DIAG_AFTER seconds, dump SDDM/session diagnostics to the serial
# console once (CI only sees serial.log), then keep waiting.
set -u
MARKER=${MARKER:-ZEEOS_DESKTOP_READY}
USER_NAME=${LIVE_USER:-liveuser}
DRY_RUN=${DRY_RUN:-0}
TIMEOUT=${TIMEOUT:-840}
DIAG_AFTER=${DIAG_AFTER:-240}

serial() { for tty in /dev/ttyS0 /dev/ttyAMA0; do [ -w "$tty" ] && cat >"$tty" && return; done; cat; }

# scan_procs <uid>: one pass over /proc with bash builtins only (no cat/awk per process: under
# TCG those forks made each poll take many seconds and starved Plasma's own startup, #98/#80).
# Sets has_plasmashell (owned by <uid>), has_xorg, has_ksplash.
scan_procs() {
    local p comm k v _
    has_plasmashell=0 has_xorg=0 has_ksplash=0
    for p in /proc/[0-9]*; do
        read -r comm <"$p/comm" 2>/dev/null || continue
        case $comm in
            Xorg) has_xorg=1 ;;
            ksplashqml) has_ksplash=1 ;;
            plasmashell)
                while read -r k v _; do
                    if [[ $k == Uid: ]]; then [[ $v == "$1" ]] && has_plasmashell=1; break; fi
                done <"$p/status" 2>/dev/null ;;
        esac
    done
}

diagnostics() {
    {
        echo "=== zeeos-desktop-ready: desktop not up after ${1}s, diagnostics follow ==="
        systemctl --no-pager status sddm.service 2>&1 | tail -n 15
        echo "--- sessions"; loginctl --no-pager list-sessions 2>&1
        echo "--- wayland-sessions"; ls /usr/share/wayland-sessions 2>&1
        echo "--- sddm config"; grep -rh -v '^#' /etc/sddm.conf /etc/sddm.conf.d /usr/lib/sddm/sddm.conf.d 2>/dev/null | grep -v '^$'
        echo "--- journal (sddm, kwin, plasma)"
        journalctl -b --no-pager -o short-monotonic -u sddm.service 2>&1 | tail -n 40
        journalctl -b --no-pager -o short-monotonic 2>/dev/null \
            | grep -E 'kwin|plasma|sddm-helper|pam_' | tail -n 40
        echo "--- coredumps"; coredumpctl --no-pager list 2>&1 | tail -n 5
        echo "=== end diagnostics ==="
    } | serial
}

uid=$(id -u "$USER_NAME" 2>/dev/null) || { echo "no user $USER_NAME" | serial; exit 1; }
up=0 diag_done=0
# Time with $SECONDS, not iterations: a slow poll must not stretch the timeout or the diagnostics.
start=$SECONDS
while (( SECONDS - start < TIMEOUT )); do
    # Ready = plasmashell on Wayland and the startup splash gone (ksplashqml exits when Plasma
    # finishes starting), so the screenshot taken at the marker shows the desktop, not the splash.
    scan_procs "$uid"
    if (( has_plasmashell && ! has_xorg && ! has_ksplash )) && [ -S "/run/user/$uid/wayland-0" ]; then
        up=1
        break
    fi
    if (( ! diag_done && SECONDS - start >= DIAG_AFTER )) && [ "$DRY_RUN" != 1 ]; then
        diagnostics "$((SECONDS - start))"; diag_done=1
    fi
    sleep 2
done
[ "$up" = 1 ] || { echo "plasmashell not up after ${TIMEOUT}s" | serial; exit 1; }

if [ "$DRY_RUN" = 1 ]; then echo "$MARKER (dry run)"; exit 0; fi
sleep "${SETTLE:-5}"   # let the panel and wallpaper paint before the harness screenshots
for tty in /dev/ttyS0 /dev/ttyAMA0 /dev/console; do
    if [ -w "$tty" ]; then echo "$MARKER" >"$tty"; fi
done
echo "$MARKER"
